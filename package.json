{
  "name": "restless",
  "version": "0.9.3",
  "description": "AI-powered SDK installer CLI. Scans your project, generates an OpenAPI spec, and wires up the Restless SDK.",
  "type": "module",
  "bin": {
    "restless": "bin/restless.js"
  },
  "files": [
    "bin",
    "lib",
    "prompts",
    "providers",
    "schemas",
    "steps",
    "docs"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "api",
    "openapi",
    "sdk",
    "cli",
    "readme",
    "restless"
  ],
  "author": "ReadMe <support@readme.io>",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.89",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "vitest": "^4.1.2"
  }
}
